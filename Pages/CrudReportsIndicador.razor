    // Método que se ejecuta cuando se inicializa el componente
    protected override async Task OnInitializedAsync()
    {
        // Llamar al método para cargar los productos
        await CargarIndicadores();
        await CargarTipoIndicador();
        await CargarUnidadmedicion();
        await CargarSentido();
        await CargarFrecuencia();
        await CargarRepreVisualIndicador();
        await CargarRepreVisual();
        await CargarResponsableIndicador();
        await CargarActor();
        await CargarTipoActor();
        await CargarFuenteIndicador();
        await CargarFuente();
        await CargarVariableIndicador();
        await CargarVariable();
        await CargarResultadoIndicador();

        var scriptRoles = @"
                Object.keys(sessionStorage)
                    .filter(key => key.startsWith('rolUsuario'))
                    .map(key => sessionStorage.getItem(key))   
            ";

        // Ejecutar el script JavaScript para obtener los roles
        roles = await JSRuntime.InvokeAsync<List<string>>(
            "eval", 
            scriptRoles
        );
    }

